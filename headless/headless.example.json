      "joinCommands": [ { "text": "/login mypassword", "delayTicks": 40 } ]
    },
    {
      "name": "Farmer_02",
      "mode": "offline",
      "proxy": "socks5://user:pass@203.0.113.20:1080"
    },
    {
      "name": "MyRealName",
      "mode": "token",
      "uuid": "00000000-0000-0000-0000-000000000000",
      "accessToken": "env:SF_TOKEN_MYREALNAME",
